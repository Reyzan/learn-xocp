# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# PHP files
*.php text eol=lf
*.phtml text eol=lf

# SQL files
*.sql text eol=lf

# Config files
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.ini text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf
LICENSE text eol=lf
README* text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# CSS/JS/Web
*.css text eol=lf
*.scss text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.jsx text eol=lf
*.tsx text eol=lf
*.html text eol=lf

# Images
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary
*.svg text eol=lf

# Fonts
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Archives
*.zip binary
*.tar binary
*.gz binary
*.tgz binary

# Composer
composer.lock text eol=lf merge=ours

# Git
.gitattributes text eol=lf
.gitignore text eol=lf
.gitmodules text eol=lf

# CI/CD
.github/** text eol=lf

# Export ignore
.gitattributes export-ignore
.gitignore export-ignore
.github/ export-ignore
tests/ export-ignore
.phpcs.xml export-ignore
phpunit.xml export-ignore
.env.example export-ignore
