if ( !defined('LOGIN_FORM_DEFINED') ) {
   define('LOGIN_FORM_DEFINED', TRUE);

session_register("login_c");
session_register("login_failed");
session_register("login_status");


class _login_Form extends XocpBlock {

   function main() {
      global $login_c,$login_failed;
      global $login,$login_status;

      $this->html->loadScript(XOCP_DOC_ROOT."/modules/login/login.js");
      $this->html->setBodyOnload(" onload=\"document.login_form.login.focus();\"");
      
      switch($this->catch) {
         default :
            $login_c = uniqid(rand());

            $loginname = new XocpFormText(_LG_LOGINNAME, "login", 15, 30, "$login");
            $password = new XocpFormPassword(_LG_PASSWORD, "passwd", 15, 30, "");
            $hidden = new XocpFormHidden("c", $login_c);
            $submit_button = new XocpFormButton("", "dologin", _LG_SUBMIT, "submit");
         
            $login_form = new XocpThemeForm(_LG_LOGINFORM, "login_form", "index.php","post");
            $login_form->setExtra("autocomplete=off onsubmit=\"return dosubmit(this,'".XOCP_URL."/login.php')\"");
         
            $login_form->addElement($loginname);
            $login_form->addElement($password);
            $login_form->addElement($hidden);
            $login_form->addElement($submit_button);
            
            if($login_failed>0) {
               switch($login_status) {
                  case XOCP_USERNOEXISTS  : $comment = _LG_USERNOEXISTS;
                                            break;
                  case XOCP_WRONGPASSWORD : $comment = _LG_WRONGPASSWORD;
                                            break;
                  case XOCP_USERINACTIVE  : $comment = _LG_USERINACTIVE;
                                            break;
               }
               $login_form->setComment(_LG_FAILED . " $login_failed : $comment");
            }
         
            return $login_form->render();
      }
   }

}


} // LOGIN_FORM_DEFINED
?>@


