class XocpCSS {
   var $css;
   
   function XocpCSS($text = "") {
      $this->css = $text;
   }
   
   function set($text) {
      $this->css = $text;
   }
   
   function load($filename) {
      if(file_exists($filename)) {
         $this->css = fread(fopen($filename, 'rb'), filesize($filename));
      }
   }
   
   function render() {
      return $this->css;
   }
}
