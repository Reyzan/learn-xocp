              . " VALUES (NULL,'$person_id','$portal_id','$user_nm','$pwd0','$pwd1','$avatar','".time()."','$icq','$viewemail','$aim','$yim','$msnm','$user_theme','$theme','$sig','$attachsig','$popmsgon','$status_cd')";
