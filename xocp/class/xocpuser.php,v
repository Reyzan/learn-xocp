         $where_query = substr($where_query, 0, -4);
      }
      $sql = "SELECT COUNT(*) FROM ".XOCP_PREFIX."users $where_query";
      $result = $db->query($sql);
      list($ret) = $db->fetchRow($result);
      return $ret;
   }


}

