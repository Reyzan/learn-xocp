   var $type;

   // public
   function XocpFormButton($caption, $name, $value="", $type="button"){
      $this->setCaption($caption);
      $this->setName($name);
      $this->type = $type;
      $this->value = $value;
   }

   // public
   function getValue(){
      return $this->value;
   }

   // public
