function myRefererCheck(&$errstr) {
	global $REQUEST_URI, $HTTP_REFERER, $HTTP_HOST, $SCRIPT_NAME;
	$referer = $HTTP_REFERER;
	if(strlen($referer) == 0) {
		return false;
	}
	$filepath = (!empty($REQUEST_URI)) ? $REQUEST_URI : $SCRIPT_NAME;
	$myurl = "http://".$HTTP_HOST.str_replace(basename($filepath),"",$filepath);
	if (strpos($referer,$myurl) != 0 ) {
		return false;
	}
	return true;
}

