   function catchVar($module) {
      global $HTTP_GET_VARS,$HTTP_POST_VARS,$HTTP_COOKIE_VARS,$HTTP_SESSION_VARS;
      global $xocp_page_id;

      foreach($HTTP_GET_VARS as $key => $val) {
         $v = explode("_",$key);
         if($v[0] == "X") {
            array_shift($v);
            $m_nm = implode("_",$v);
            if($m_nm == $module) {
               return $val;
            } else {
               return NULL;
            }
         } elseif ($v[0] == "XP") {
            $xocp_page_id = $v[1];
            array_splice($v,0,2);
            $m_nm = implode("_",$v);
            if($m_nm == $module) {
               return $val;
            } else {
               return NULL;
            }
         }
      }

      foreach($HTTP_POST_VARS as $key => $val) {
         $v = explode("_",$key);
         if($v[0] == "X") {
            array_shift($v);
            $m_nm = implode("_",$v);
