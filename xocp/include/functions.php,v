   function checkIp($ip){
      global $xocpBadIps;
      if ( !empty($xocpBadIps) ) {
         foreach ($xocpBadIps as $xbi) {
            if ( !empty($xbi) && preg_match("/".$xbi."/", $ip)) {
               return false;
            }
         }
      }
      return true;
   }

   function checkEmail($email){
      if (!$email || !eregi("^[_a-z0-9-]+(\.[_a-z0-9-]+)*@@[a-z0-9-]+([\.][a-z0-9-]+)+$",$email)){
         return false;
      }
      return true;
   }

   function formatURL($url){
      if (($url != "") && (!(eregi('(^http[s]*:[/]+)(.*)', $url)))){
         $url = "http://" . $url;
      }
      return $url;
   }

   /*
