# Application Configuration
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost/xocp

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=xocp
DB_USERNAME=root
DB_PASSWORD=
DB_PREFIX=

# Session Configuration
SESSION_LIFETIME=7200
SESSION_DRIVER=file

# Security
APP_KEY=

# Logging
LOG_LEVEL=info
LOG_CHANNEL=daily

# Cache Configuration
CACHE_DRIVER=file

# Mail Configuration (optional)
MAIL_DRIVER=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=noreply@xocp.local
MAIL_FROM_NAME="XOCP Portal"

# PHP Configuration Hints
# Recommended php.ini settings:
# memory_limit = 256M
# max_execution_time = 300
# upload_max_filesize = 64M
# post_max_size = 64M
# opcache.enable = 1
# opcache.jit_buffer_size = 100M (PHP 8+)
# opcache.jit = 1255 (PHP 8+)
